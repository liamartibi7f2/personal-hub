rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Admin = tài khoản có document admins/{uid}.
    // Document này CHỈ tạo được thủ công trong Firebase Console (client không ghi được).
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }

    // Client chỉ được đọc đúng document của chính mình (để biết mình có phải admin không)
    match /admins/{id} {
      allow read: if isOwner(id);
      allow write: if false;
    }

    // Danh bạ người dùng: mỗi người tự ghi hồ sơ của mình, admin được đọc tất cả
    match /userDirectory/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // Dữ liệu thu chi:
    //   - Chủ tài khoản: đọc + ghi
    //   - Admin: CHỈ ĐỌC (không có quyền write dù ở bất kỳ document nào)
    match /users/{uid}/cashflow/{doc} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    // Lịch / Quản lý thời gian (module Time):
    //   - Chủ tài khoản: đọc + ghi
    //   - Admin: CHỈ ĐỌC (không có quyền create, update, delete)
    //   - Document phải đúng dạng { schema, json, updatedAt } và json không quá lớn
    match /users/{uid}/timeManagement/{doc} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['schema', 'json', 'updatedAt'])
                    && request.resource.data.json is string
                    && request.resource.data.json.size() <= 940000;
      allow delete: if isOwner(uid);
    }

    // Thông báo trạng thái Admin đang xem:
    //   - Admin: đọc + ghi heartbeat/active
    //   - Chủ tài khoản: đọc + chỉ được cập nhật trường seenAt
    match /users/{uid}/adminAccess/{doc} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt']));
      allow delete: if isAdmin();
    }

    // Dữ liệu riêng của Personal-hub (Flashcards, Quiz, Focus, Pomodoro, Notes, Settings):
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/notes_store/{doc} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/notes_backup_vault/{doc} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/flashcard_store/{doc} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/settings/{doc} {
      allow read, write: if isOwner(uid);
    }
    match /shared_quizzes/{code} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // COLLAB HUB — phòng giữ streak chung (module Cộng tác)
    //   rooms/{roomId}                       thông tin + luật phòng + trạng thái quản lý
    //        name, code, ownerUid, maxHearts, regenDays, cutoff, createdAt,
    //        maxMembers (2–20), joinOpen (khoá/mở cho người mới), memberCount (đếm thành viên), deleting (đang xoá),
    //        photoDays (3–365, mặc định 30: ảnh check-in mới tự hết hạn sau bấy nhiêu ngày),
    //        challenge (bật/tắt mã thử thách mỗi lần chụp; thiếu = tắt),
    //        quest ('off' | 'random' | 'owner'; thiếu = off): Đề ngày — mỗi ngày một đề chụp ảnh cho cả phòng
    //   rooms/{roomId}/members/{uid}         hồ sơ + cam kết của từng người (+ avatar: id ảnh có sẵn, '' / thiếu = chữ cái)
    //   rooms/{roomId}/checkins/{uid_date}   mỗi người mỗi ngày đúng một check-in (BẮT BUỘC kèm ảnh lúc tạo)
    //        + photoMode (all | some | me), photoExpireAt, photoState (deleted | expired khi ảnh đã gỡ). Giờ check-in luôn được giữ.
    //        + ch (mã thử thách 'P482' | 'F7' | ''), ph / pm (dấu vân tay ảnh dHash 256 bit và bản lật ngang; dùng báo ảnh trùng, sống lâu hơn ảnh)
    //        + qid ('pool<N>' = đề dự phòng | '<date>_<uid người ra đề>'), qt (bản chụp tiêu đề đề ngày, ≤ 60) — phòng bật Đề ngày thì BẮT BUỘC có qid
    //   rooms/{roomId}/reviews/{uid_date_voter}  phiếu duyệt chéo: { target, by, v: ok | sus, ref, at, off? }
    //        off: true = "Lạc đề" (ảnh thật nhưng sai đề; chỉ với v = ok và check-in có qid) — KHÔNG hủy check-in, chỉ mất ✦ đúng đề
    //        quá nửa người KHÁC nghi ngờ → check-in bị hủy (client tính lại từ phiếu, không lưu cờ)
    //   rooms/{roomId}/photos/{uid_date}     ảnh check-in (JPEG dataURL đã nén), tách riêng cho nhẹ
    //        + viewers (không có = cả phòng · [] = chỉ mình · [uid…] = chỉ những người đó), expireAt (TTL của Firestore dọn)
    //   rooms/{roomId}/nudges/{from_to_date} lời nhắc nhẹ
    //   rooms/{roomId}/quests/{date_uid}      Đề ngày: { date, day, by, title, hint, pass, at } — người được bốc thăm đăng; pass = nhường lượt
    //   invites/{code}                       mã mời → roomId, có hạn dùng (expiresAt, null = không hết hạn)
    //   users/{uid}/collab/rooms             danh sách phòng của mình
    //
    // QUẢN LÝ PHÒNG
    //   Chủ phòng: đổi tên, số người tối đa, khoá/mở phòng, đổi mã mời, đổi hạn dùng mã,
    //              mời thành viên ra, chuyển quyền chủ phòng, xoá phòng (2 bước: deleting = true rồi dọn dữ liệu).
    //   Thành viên: tự rời phòng. Chủ phòng KHÔNG tự rời được (phải chuyển quyền hoặc xoá phòng).
    // ─────────────────────────────────────────────────────────────
    function isRoomMember(roomId) {
      return signedIn() &&
        exists(/databases/$(db)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    function dayNum(t) { return t.year() * 10000 + t.month() * 100 + t.day(); }   // 20261124

    // Chủ phòng / phòng đang bị xoá (đọc thẳng từ document phòng)
    function isRoomOwner(roomId) {
      return signedIn() &&
        get(/databases/$(db)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid;
    }
    function roomDeleting(roomId) {
      return get(/databases/$(db)/documents/rooms/$(roomId)).data.get('deleting', false) == true;
    }
    // Hạn dùng của mã: không có (null) hoặc nằm trong tương lai, tối đa 31 ngày
    function validExpiry(v) {
      return v == null ||
        (v is timestamp && v > request.time && v <= request.time + duration.value(31, 'd'));
    }
    // Điều kiện để một người (chưa là thành viên) vào phòng bằng mã:
    // mã đúng phòng + còn hạn, phòng đang mở, không bị xoá, còn chỗ, và đếm thành viên tăng đúng +1 trong cùng batch
    function canJoin(roomId, code) {
      let roomPath = /databases/$(db)/documents/rooms/$(roomId);
      let before = get(roomPath).data;
      let after = getAfter(roomPath).data;
      let inv = get(/databases/$(db)/documents/invites/$(code)).data;
      return inv.roomId == roomId
          && (inv.get('expiresAt', null) == null || inv.expiresAt > request.time)
          && after.get('joinOpen', true) == true
          && after.get('deleting', false) == false
          && after.get('memberCount', 0) == before.get('memberCount', 0) + 1
          && after.get('memberCount', 0) <= after.get('maxMembers', 20);
    }

    // ── Ảnh check-in: quyền riêng tư + hạn sống ──────────────────
    // viewers: không có = cả phòng xem được · [] = chỉ mình tôi · [uid, …] = chỉ những người này (và chủ ảnh)
    function modeOf(viewers) {
      return viewers == null ? 'all' : (viewers.size() == 0 ? 'me' : 'some');
    }
    function validViewers(v) {
      return v == null || (v is list && v.size() <= 19);
    }
    // Đọc được khi CHƯA hết hạn (kể cả lúc TTL chưa kịp xoá, có thể trễ tới ~24 giờ) và người đọc nằm trong danh sách xem
    function photoReadable(d) {
      return (!('expireAt' in d) || d.expireAt > request.time)
          && (d.uid == request.auth.uid
              || d.get('viewers', null) == null
              || request.auth.uid in d.viewers);
    }
    // Hạn của ảnh mới: ở tương lai và không quá photoDays ngày của phòng (mặc định 30).
    // CHUYỂN TIẾP: vế "!('expireAt' in d)" cho phép máy chưa cập nhật vẫn check-in được. Khi mọi máy đã dùng
    // bản JS mới, xoá vế đó để BẮT BUỘC ảnh nào cũng có hạn.
    function photoExpiryOk(roomId, d) {
      return !('expireAt' in d)
          || (d.expireAt is timestamp
              && d.expireAt > request.time
              && d.expireAt <= request.time + duration.value(
                   get(/databases/$(db)/documents/rooms/$(roomId)).data.get('photoDays', 30), 'd'));
    }
    // ── Mã thử thách · dấu vân tay ảnh ───────────────────────────
    //   ch: 'P' + số 100–999 (viết lên giấy) hoặc 'F' + 1–10 (giơ ngón tay); '' = không có.
    //   ph / pm: 64 ký tự hex (256 bit). Luật chỉ kiểm định dạng; việc đối chiếu số trên ảnh là của người duyệt.
    function okAvatar(d) { return d.get('avatar', '') is string && d.get('avatar', '').matches('^[a-z0-9]{0,16}$'); }   // id avatar có sẵn trong app ('' = dùng chữ cái)
    function okCode(v) { return v is string && (v == '' || v.matches('^(P[1-9][0-9]{2}|F([1-9]|10))$')); }
    function okHash(v) { return v is string && (v == '' || v.matches('^[0-9a-f]{64}$')); }
    function challengeOn(roomId) {
      return get(/databases/$(db)/documents/rooms/$(roomId)).data.get('challenge', false) == true;
    }

    // ── Đề ngày (daily quest) ────────────────────────────────────
    //   Việc bốc thăm "ai ra đề hôm nay" là hàm thuần của client (mọi máy tính ra cùng kết quả, giống cách tính streak),
    //   nên Rules chỉ kiểm định dạng + giới hạn: ai cũng đăng được nhiều nhất 1 đề / ngày (id gắn uid → không chặn được ngày của người khác),
    //   client chỉ nhận đề của người nằm trong 3 người đầu danh sách bốc thăm của ngày đó.
    function validQuest(d) { return !('quest' in d) || d.quest in ['off', 'random', 'owner']; }
    function questMode(roomId) { return get(/databases/$(db)/documents/rooms/$(roomId)).data.get('quest', 'off'); }
    function questOn(roomId) { return questMode(roomId) in ['random', 'owner']; }
    function okQid(v) { return v is string && (v == '' || v.matches('^(pool[0-9]{1,3}|[0-9]{4}-[0-9]{2}-[0-9]{2}_[A-Za-z0-9_-]{1,128})$')); }
    function okQuestBody(d) {
      return d.get('pass', false) is bool
          && d.title is string && d.title.size() <= 60
          && d.hint is string && d.hint.size() <= 120
          && (d.get('pass', false) == true || d.title.size() >= 1);      // nhường lượt thì không cần đề
    }
    // Phiếu "Lạc đề" (off) chỉ đi với v = ok và chỉ trên check-in có qid
    function okOffVote(d, ck) {
      return d.get('off', false) is bool
          && (d.get('off', false) == false || (d.v == 'ok' && ck.get('qid', '') != ''));
    }

    // ── Duyệt chéo ───────────────────────────────────────────────
    // Một phiếu = (ảnh, người duyệt). Id phiếu = <uid_date> + '_' + <uid người duyệt>.
    //   - người duyệt là thành viên, KHÔNG phải chủ check-in
    //   - ref = giây của check-in.at → phiếu cũ không dính sang lần check-in mới (xoá rồi chụp lại)
    //   - chỉ duyệt được ảnh mà mình ĐỌC được (còn hạn, nằm trong viewers) — không thể duyệt thứ mình không thấy
    //   - trong 72 giờ kể từ check-in; hết hạn thì chốt, ai cũng không đổi được nữa
    function validReviewTarget(ck, ph, ref) {
      return ck.uid != request.auth.uid
          && ck.hasPhoto == true
          && photoReadable(ph)
          && ck.at is timestamp
          && ref * 1000 <= ck.at.toMillis()
          && ck.at.toMillis() < (ref + 1) * 1000
          && request.time < ck.at + duration.value(3, 'd');
    }
    function validReview(roomId, id) {
      let d = request.resource.data;
      let ckPath = /databases/$(db)/documents/rooms/$(roomId)/checkins/$(d.target);
      let phPath = /databases/$(db)/documents/rooms/$(roomId)/photos/$(d.target);
      return d.keys().hasOnly(['target', 'by', 'v', 'ref', 'at', 'off'])
          && d.target is string && d.target.size() >= 1 && d.target.size() <= 80
          && d.by == request.auth.uid
          && id == d.target + '_' + d.by
          && d.v in ['ok', 'sus']
          && d.ref is int && d.ref >= 1000000000 && d.ref <= 9999999999
          && d.at == request.time
          && exists(ckPath) && exists(phPath)
          && validReviewTarget(get(ckPath).data, get(phPath).data, d.ref)
          && okOffVote(d, get(ckPath).data);
    }

    function validPhotoDays(d) {
      return !('photoDays' in d) || (d.photoDays is int && d.photoDays >= 3 && d.photoDays <= 365);
    }

    // Mã mời: chỉ đọc được từng mã một (không liệt kê) → phải biết mã mới vào được phòng.
    // Chỉ CHỦ PHÒNG mới tạo / sửa hạn / thu hồi được mã của phòng mình.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.keys().hasOnly(['roomId', 'createdBy', 'createdAt', 'expiresAt'])
                    && getAfter(/databases/$(db)/documents/rooms/$(request.resource.data.roomId)).data.ownerUid == request.auth.uid
                    && validExpiry(request.resource.data.get('expiresAt', null));
      allow update: if signedIn()
                    && isRoomOwner(resource.data.roomId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
                    && validExpiry(request.resource.data.get('expiresAt', null));
      allow delete: if signedIn() && isRoomOwner(resource.data.roomId);
      allow list: if false;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['name', 'code', 'ownerUid', 'maxHearts', 'regenDays', 'cutoff', 'createdAt', 'maxMembers', 'joinOpen', 'memberCount', 'photoDays', 'challenge', 'quest'])
                    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
                    && request.resource.data.get('memberCount', 1) == 1
                    && request.resource.data.get('joinOpen', true) == true
                    && (!('maxMembers' in request.resource.data)
                        || (request.resource.data.maxMembers is int && request.resource.data.maxMembers >= 2 && request.resource.data.maxMembers <= 20))
                    && validPhotoDays(request.resource.data)
                    && request.resource.data.get('challenge', false) is bool
                    && validQuest(request.resource.data);
      allow read: if isRoomMember(roomId);

      // CHỦ PHÒNG: đổi tên, luật tim, mã mời, số người tối đa, khoá/mở, đếm thành viên,
      // chuyển quyền (chỉ cho một thành viên đang ở trong phòng), đánh dấu đang xoá (chỉ được bật, không tắt)
      allow update: if isRoomMember(roomId)
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['name', 'maxHearts', 'regenDays', 'code', 'maxMembers', 'joinOpen', 'ownerUid', 'memberCount', 'deleting', 'photoDays', 'challenge', 'quest'])
                    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
                    && (!('maxMembers' in request.resource.data)
                        || (request.resource.data.maxMembers is int && request.resource.data.maxMembers >= 2 && request.resource.data.maxMembers <= 20))
                    && (!('joinOpen' in request.resource.data) || request.resource.data.joinOpen is bool)
                    && validPhotoDays(request.resource.data)
                    && request.resource.data.get('challenge', false) is bool
                    && validQuest(request.resource.data)
                    && (!('memberCount' in request.resource.data) || request.resource.data.memberCount is int)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['maxMembers'])
                        || request.resource.data.maxMembers >= request.resource.data.get('memberCount', 0))
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleting'])
                        || request.resource.data.deleting == true)
                    && (request.resource.data.ownerUid == resource.data.ownerUid
                        || exists(/databases/$(db)/documents/rooms/$(roomId)/members/$(request.resource.data.ownerUid)))
                    && (request.resource.data.code == resource.data.code
                        || getAfter(/databases/$(db)/documents/invites/$(request.resource.data.code)).data.roomId == roomId);

      // NGƯỜI VÀO / RỜI: chỉ được đụng memberCount (±1) khi hồ sơ thành viên của chính mình được tạo / xoá trong cùng batch
      allow update: if signedIn()
                    && resource.data.ownerUid != request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
                    && ((request.resource.data.memberCount == resource.data.get('memberCount', 0) + 1
                         && !exists(/databases/$(db)/documents/rooms/$(roomId)/members/$(request.auth.uid))
                         && existsAfter(/databases/$(db)/documents/rooms/$(roomId)/members/$(request.auth.uid)))
                        || (request.resource.data.memberCount == resource.data.get('memberCount', 0) - 1
                         && exists(/databases/$(db)/documents/rooms/$(roomId)/members/$(request.auth.uid))
                         && !existsAfter(/databases/$(db)/documents/rooms/$(roomId)/members/$(request.auth.uid))));

      // Xoá phòng: chỉ chủ phòng, và chỉ sau khi đã đánh dấu deleting = true (client dọn dữ liệu con trước)
      allow delete: if isRoomOwner(roomId) && resource.data.get('deleting', false) == true;

      match /members/{uid} {
        allow read: if isRoomMember(roomId);
        // Chủ phòng tạo hồ sơ cùng lúc với phòng (phòng chưa tồn tại trước batch);
        // người khác phải vào bằng mã hợp lệ: đúng phòng, còn hạn, phòng đang mở và còn chỗ (xem canJoin)
        allow create: if signedIn() && request.auth.uid == uid
                      && request.resource.data.uid == uid
                      && request.resource.data.keys().hasOnly(['uid', 'name', 'commits', 'joinedAt', 'code', 'avatar'])
                      && okAvatar(request.resource.data)
                      && request.resource.data.name is string && request.resource.data.name.size() <= 24
                      && request.resource.data.commits is list && request.resource.data.commits.size() <= 60
                      && ((!exists(/databases/$(db)/documents/rooms/$(roomId))
                           && getAfter(/databases/$(db)/documents/rooms/$(roomId)).data.ownerUid == uid)
                          || canJoin(roomId, request.resource.data.code));
        // Chỉ sửa hồ sơ của chính mình (cam kết, tên)
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.uid == uid
                      && request.resource.data.name is string && request.resource.data.name.size() <= 24
                      && request.resource.data.commits is list && request.resource.data.commits.size() <= 60
                      && okAvatar(request.resource.data);
        // Tự rời phòng (chủ phòng chỉ rời được khi phòng đang bị xoá), hoặc chủ phòng mời người khác ra
        allow delete: if signedIn() && request.auth.uid == uid
                      && (!isRoomOwner(roomId) || roomDeleting(roomId));
        allow delete: if isRoomOwner(roomId) && uid != request.auth.uid;
      }

      // Check-in: chỉ cho chính mình, giờ lấy từ máy chủ, mỗi (người, ngày) một tài liệu,
      // ngày ghi chỉ lệch tối đa ±1 ngày so với giờ máy chủ (chặn ghi bù xa),
      // và PHẢI có ảnh lúc tạo: tài liệu photos cùng id phải được ghi trong cùng batch (existsAfter).
      // photoMode / photoExpireAt là bản "công khai" của quyền riêng tư và hạn ảnh để giao diện biết trạng thái
      // mà không phải đọc ảnh (nặng); luật ép chúng khớp với tài liệu photos.
      match /checkins/{id} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
                      && request.resource.data.keys().hasOnly(['uid', 'date', 'day', 'at', 'note', 'late', 'hasPhoto', 'photoMode', 'photoExpireAt', 'ch', 'ph', 'pm', 'qid', 'qt'])
                      && request.resource.data.hasPhoto == true
                      && okCode(request.resource.data.get('ch', ''))
                      && okHash(request.resource.data.get('ph', ''))
                      && okHash(request.resource.data.get('pm', ''))
                      && (!challengeOn(roomId) || request.resource.data.get('ch', '') != '')      // phòng bật mã thử thách → bắt buộc kèm mã
                      && okQid(request.resource.data.get('qid', ''))
                      && request.resource.data.get('qt', '') is string
                      && request.resource.data.get('qt', '').size() <= 60
                      && (request.resource.data.get('qid', '') == ''
                          || (request.resource.data.get('qt', '').size() >= 1
                              && (request.resource.data.get('qid', '').matches('^pool[0-9]{1,3}$')
                                  || request.resource.data.get('qid', '').split('_')[0] == request.resource.data.date)))   // đề của đúng ngày check-in
                      && (!questOn(roomId) || request.resource.data.get('qid', '') != '')          // phòng bật Đề ngày → bắt buộc kèm đề
                      && existsAfter(/databases/$(db)/documents/rooms/$(roomId)/photos/$(id))
                      && request.resource.data.get('photoMode', 'all')
                           == modeOf(getAfter(/databases/$(db)/documents/rooms/$(roomId)/photos/$(id)).data.get('viewers', null))
                      && request.resource.data.get('photoExpireAt', null)
                           == getAfter(/databases/$(db)/documents/rooms/$(roomId)/photos/$(id)).data.get('expireAt', null)
                      && request.resource.data.uid == request.auth.uid
                      && id == request.auth.uid + '_' + request.resource.data.date
                      && request.resource.data.at == request.time
                      && request.resource.data.note is string && request.resource.data.note.size() <= 120
                      && request.resource.data.day in [dayNum(request.time - duration.value(1, 'd')),
                                                       dayNum(request.time),
                                                       dayNum(request.time + duration.value(1, 'd'))];
        // Hoàn tác: chỉ xoá check-in của mình trong vòng 5 phút
        allow delete: if isRoomMember(roomId)
                      && resource.data.uid == request.auth.uid
                      && resource.data.at > request.time - duration.value(5, 'm');
        // Dọn phòng: chủ phòng chỉ xoá được khi phòng đã đánh dấu deleting
        allow delete: if isRoomOwner(roomId) && roomDeleting(roomId);
        // Chủ check-in được sửa DUY NHẤT phần ảnh (giờ / ngày / ghi chú vẫn bất biến):
        //   (a) đổi chế độ xem: photoMode phải khớp viewers của ảnh sau batch
        //   (b) gỡ ảnh: hasPhoto true → false, photoState = deleted | expired, và ảnh không còn tồn tại sau batch
        allow update: if isRoomMember(roomId)
                      && resource.data.uid == request.auth.uid
                      && (
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoMode'])
                          && resource.data.hasPhoto == true
                          && existsAfter(/databases/$(db)/documents/rooms/$(roomId)/photos/$(id))
                          && request.resource.data.photoMode
                               == modeOf(getAfter(/databases/$(db)/documents/rooms/$(roomId)/photos/$(id)).data.get('viewers', null)))
                        ||
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasPhoto', 'photoState'])
                          && resource.data.hasPhoto == true
                          && request.resource.data.hasPhoto == false
                          && request.resource.data.photoState in ['deleted', 'expired']
                          && !existsAfter(/databases/$(db)/documents/rooms/$(roomId)/photos/$(id)))
                      );
      }

      // Ảnh check-in: chỉ chủ ảnh ghi, giờ máy chủ, dung lượng chuỗi ≤ 400k ký tự (~300KB).
      //   - Đọc từng ảnh (get): chỉ khi còn hạn và người đọc nằm trong viewers (xem photoReadable)
      //   - Liệt kê (list): chỉ ảnh của chính mình, để dọn ảnh hết hạn → query phải có where('uid', '==', uid)
      //   - Chủ ảnh xoá bất cứ lúc nào, đổi viewers bất cứ lúc nào (không kéo dài được hạn)
      match /photos/{id} {
        allow get: if isRoomMember(roomId) && photoReadable(resource.data);
        allow list: if isRoomMember(roomId) && resource.data.uid == request.auth.uid;
        allow create: if isRoomMember(roomId)
                      && request.resource.data.keys().hasOnly(['uid', 'date', 'img', 'at', 'viewers', 'expireAt'])
                      && request.resource.data.uid == request.auth.uid
                      && id == request.auth.uid + '_' + request.resource.data.date
                      && request.resource.data.at == request.time
                      && request.resource.data.img is string
                      && request.resource.data.img.size() <= 400000
                      && validViewers(request.resource.data.get('viewers', null))
                      && photoExpiryOk(roomId, request.resource.data);
        allow update: if isRoomMember(roomId)
                      && resource.data.uid == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
                      && validViewers(request.resource.data.get('viewers', null))
                      && (!('expireAt' in resource.data) || resource.data.expireAt > request.time);
        // Xoá ảnh của mình (xoá một tài liệu không tồn tại là vô hại: cho phép để dọn hàng loạt không bị vướng)
        allow delete: if isRoomMember(roomId)
                      && (resource == null || resource.data.uid == request.auth.uid);
        // Dọn phòng (xem checkins)
        allow delete: if isRoomOwner(roomId) && roomDeleting(roomId);
      }

      // Phiếu duyệt chéo (xem validReview). Đổi ý = ghi đè chính phiếu của mình (chỉ v / ref / at đổi được), trong 72 giờ.
      // Không ai xoá được phiếu của ai (kể cả chủ ảnh) — chỉ chủ phòng khi dọn phòng.
      match /reviews/{id} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId) && validReview(roomId, id);
        allow update: if isRoomMember(roomId)
                      && resource.data.by == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v', 'ref', 'at', 'off'])
                      && validReview(roomId, id);
        allow delete: if isRoomOwner(roomId) && roomDeleting(roomId);
      }

      // Đề ngày. Id = <date>_<uid người đăng>.
      //   - tạo: thành viên, phòng đang bật đề, ngày trong khoảng [hôm qua, +8 ngày] theo giờ máy chủ và khớp trường `day`,
      //          chế độ 'owner' thì chỉ chủ phòng; giờ lấy từ máy chủ
      //   - sửa (title / hint / pass) và xoá: chính người đăng, tới hết ngày áp dụng (so theo UTC, lệch tối đa ±1 như check-in);
      //          đề đã dùng không mất vì check-in giữ bản chụp tiêu đề (qt)
      //   - chủ phòng xoá được mọi đề (kiểm duyệt, và dọn phòng khi xoá)
      match /quests/{id} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
                      && questOn(roomId)
                      && request.resource.data.keys().hasOnly(['date', 'day', 'by', 'title', 'hint', 'pass', 'at'])
                      && request.resource.data.keys().hasAll(['date', 'day', 'by', 'title', 'hint', 'at'])
                      && request.resource.data.by == request.auth.uid
                      && request.resource.data.date is string
                      && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                      && id == request.resource.data.date + '_' + request.auth.uid
                      && request.resource.data.day is int
                      && request.resource.data.day == int(request.resource.data.date.replace('-', ''))
                      && request.resource.data.day >= dayNum(request.time - duration.value(1, 'd'))
                      && request.resource.data.day <= dayNum(request.time + duration.value(8, 'd'))
                      && request.resource.data.at == request.time
                      && okQuestBody(request.resource.data)
                      && (questMode(roomId) != 'owner' || isRoomOwner(roomId));
        allow update: if isRoomMember(roomId)
                      && resource.data.by == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'hint', 'pass'])
                      && okQuestBody(request.resource.data)
                      && resource.data.day >= dayNum(request.time);
        allow delete: if isRoomMember(roomId)
                      && resource.data.by == request.auth.uid
                      && resource.data.day >= dayNum(request.time);
        allow delete: if isRoomOwner(roomId);
      }

      match /nudges/{id} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
                      && request.resource.data.keys().hasOnly(['from', 'to', 'date', 'at'])
                      && request.resource.data.from == request.auth.uid
                      && id == request.auth.uid + '_' + request.resource.data.to + '_' + request.resource.data.date;
        allow delete: if isRoomOwner(roomId) && roomDeleting(roomId);
        allow update: if false;
      }
    }

    // Danh sách phòng của mỗi người (riêng tư, chỉ chủ tài khoản)
    match /users/{uid}/collab/{doc} {
      allow read, write: if isOwner(uid);
    }

    // Nhật ký xem: admin tự ghi (chỉ được ghi bằng đúng uid của mình), không sửa/xóa được
    match /auditLogs/{id} {
      allow create: if isAdmin()
                    && request.resource.data.adminUid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
